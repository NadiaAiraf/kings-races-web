# Firebase web app config. Copy to .env.local and fill in from
# Firebase console > Project settings > General > Your apps > Web app.
# These values are public by design; access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development only: point the app at the Firebase emulators
# (npm run emulators). Production builds refuse to start with this set.
VITE_FIREBASE_USE_EMULATORS=false
