rules_version = '2';

// These rules are the real access control; the app only hides controls.
// They are not deployed by CI. After changing them, deploy by hand:
//   npx firebase deploy --only firestore:rules --project <projectId>
//
// Event shape must match buildNewEventDoc and FirestoreDiscipline in
// src/events/eventDoc.ts (scores and tiebreaks are maps keyed by race id /
// group so concurrent scorers write separate fields).

service cloud.firestore {
  match /databases/{database}/documents {

    // Approval is an allowlist managed by hand in the Firebase console:
    // approvedUsers/{uid} exists => that user may create and score events.
    function isApproved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid));
    }

    function eventKeys() {
      return ['name', 'date', 'createdBy', 'createdAt', 'updatedAt', 'disciplines'];
    }

    // Where a round sits in a season (see SeasonRound in src/seasons/seasons.ts).
    // Optional so rounds created before seasons existed stay valid.
    function seasonRoundKeys() {
      return ['seasonId', 'league', 'roundNumber', 'venue'];
    }

    // All or none of the season fields. The id must be derived from them
    // (seasonRoundEventId) so each league has at most one R1..R4 per season.
    function hasValidSeasonRound(eventId, data) {
      return !data.keys().hasAny(seasonRoundKeys())
        || (data.keys().hasAll(seasonRoundKeys())
          && data.seasonId is string
          && data.league in ['southern', 'western', 'northern', 'midlands', 'scotland']
          && data.roundNumber is int
          && data.roundNumber >= 1
          && data.roundNumber <= 4
          && data.venue is string
          && data.venue.size() > 0
          && data.venue.size() <= 60
          && eventId == data.seasonId + '_' + data.league + '_r' + string(data.roundNumber)
          && exists(/databases/$(database)/documents/seasons/$(data.seasonId)));
    }

    function isValidDiscipline(d) {
      return d is map
        && d.keys().hasOnly(['teams', 'phase', 'scores', 'manualTiebreaks', 'placings'])
        && d.teams is list
        && d.teams.size() <= 31
        && d.phase in ['setup', 'group-stage', 'round-two', 'finals', 'complete']
        && d.scores is map
        && d.manualTiebreaks is map
        && (!('placings' in d) || d.placings is map);
    }

    function hasValidFields(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.date is string
        && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.disciplines is map
        && data.disciplines.keys().hasOnly(['mixed', 'board', 'ladies'])
        && data.disciplines.keys().hasAll(['mixed', 'board', 'ladies'])
        && isValidDiscipline(data.disciplines.mixed)
        && isValidDiscipline(data.disciplines.board)
        && isValidDiscipline(data.disciplines.ladies);
    }

    // Teams decide which slot each result belongs to, so they may only change
    // in a discipline with no results (e.g. a stale offline team edit must not
    // re-slot teams under another device's scores). A reset clears both.
    function teamsChangeAllowed(key) {
      return request.resource.data.disciplines[key].teams == resource.data.disciplines[key].teams
        || request.resource.data.disciplines[key].scores.size() == 0;
    }

    match /events/{eventId} {
      // Anyone, signed in or not, can watch any event. List queries must be
      // bounded (EVENT_LIST_LIMIT in eventsRepo.ts) to protect the read quota.
      allow get: if true;
      allow list: if request.query.limit <= 40;

      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(eventKeys().concat(seasonRoundKeys()))
        && request.resource.data.keys().hasAll(eventKeys())
        && hasValidSeasonRound(eventId, request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidFields(request.resource.data);

      // name and date stay editable for a future rename UI (console edits
      // bypass these rules anyway); createdBy/createdAt and the season
      // fields never change.
      allow update: if isApproved()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'date', 'updatedAt', 'disciplines'])
        && request.resource.data.updatedAt == request.time
        && hasValidFields(request.resource.data)
        && teamsChangeAllowed('mixed')
        && teamsChangeAllowed('board')
        && teamsChangeAllowed('ladies');

      allow delete: if false;
    }

    // A season document's id is derived from its start year (seasonIdFor in
    // src/seasons/seasons.ts), so each season exists at most once.
    match /seasons/{seasonId} {
      allow get: if true;
      allow list: if request.query.limit <= 20;

      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['startYear', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['startYear', 'createdBy', 'createdAt'])
        && request.resource.data.startYear is int
        && request.resource.data.startYear >= 2020
        && request.resource.data.startYear <= 2098
        && seasonId == string(request.resource.data.startYear) + '-'
             + string((request.resource.data.startYear + 1) % 100)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // A league's team list for a season (see LeagueTeams in
    // src/seasons/leagueTeams.ts). Unlike a round it may exceed 31 teams.
    function isValidTeamList(data, key) {
      return !(key in data) || (data[key] is list && data[key].size() <= 100);
    }

    match /seasons/{seasonId}/leagues/{league} {
      allow get: if true;

      allow create, update: if isApproved()
        && league in ['southern', 'western', 'northern', 'midlands', 'scotland']
        && exists(/databases/$(database)/documents/seasons/$(seasonId))
        && request.resource.data.keys().hasOnly(['mixed', 'board', 'ladies', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && isValidTeamList(request.resource.data, 'mixed')
        && isValidTeamList(request.resource.data, 'board')
        && isValidTeamList(request.resource.data, 'ladies');

      allow delete: if false;
    }

    match /approvedUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
